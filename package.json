{
	"name": "tekseries",
	"version": "1.25.0",
	"private": true,
	"description": "TekSeries block theme and companion blocks plugin.",
	"author": "Beekomm Technologies",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": "^24.15.0 || >=26.0.0",
		"npm": ">=11.0.0"
	},
	"workspaces": [
		"wp-content/plugins/tekseries-blocks"
	],
	"prettier": "@wordpress/prettier-config",
	"scripts": {
		"check-engines": "wp-scripts check-engines",
		"lint:js": "wp-scripts lint-js wp-content/plugins/tekseries-blocks scripts specs tests types eslint.config.cjs playwright.config.ts vitest.config.mts --no-error-on-unmatched-pattern",
		"lint:css": "wp-scripts lint-style \"wp-content/themes/tekseries/**/*.{css,scss}\" \"wp-content/plugins/tekseries-blocks/src/**/*.{css,scss}\" \"wp-content/plugins/tekseries-blocks/assets/css/*.css\" --allow-empty-input",
		"format": "wp-scripts format wp-content/themes/tekseries wp-content/plugins/tekseries-blocks scripts specs tests types eslint.config.cjs playwright.config.ts vitest.config.mts",
		"typecheck": "tsc --noEmit",
		"test:unit": "wp-scripts test-unit-js",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install chromium",
		"icons": "node scripts/fetch-icons.mjs",
		"build": "npm run build --workspace=tekseries-blocks",
		"start": "npm run start --workspace=tekseries-blocks",
		"plugin-zip": "npm run plugin-zip --workspace=tekseries-blocks",
		"theme-zip": "cd wp-content/themes && zip -qr -FS tekseries.zip tekseries",
		"wp-env": "wp-env"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@playwright/test": "^1.64.0",
		"@types/node": "^24.19.1",
		"@types/react": "18.3.31",
		"@wordpress/babel-preset-default": "^9.0.0",
		"@wordpress/e2e-test-utils-playwright": "^3.0.0",
		"@wordpress/env": "^11.17.0",
		"@wordpress/eslint-plugin": "^27.1.0",
		"@wordpress/prettier-config": "^4.57.0",
		"@wordpress/scripts": "^36.1.0",
		"prettier": "npm:wp-prettier@^3.9.6",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	}
}
