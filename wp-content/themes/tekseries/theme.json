{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"viewport": {
			"mobile": "640px",
			"tablet": "1100px"
		},
		"layout": {
			"contentSize": "880px",
			"wideSize": "1440px"
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [],
			"palette": [
				{ "slug": "plum", "name": "Plum", "color": "#4A1D5E" },
				{ "slug": "ink", "name": "Ink", "color": "#2A1533" },
				{ "slug": "saffron", "name": "Saffron", "color": "#F4A261" },
				{ "slug": "coral", "name": "Coral", "color": "#E76F51" },
				{ "slug": "coral-text", "name": "Coral Text", "color": "#CE401C" },
				{ "slug": "blush", "name": "Blush", "color": "#FBF7F9" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" },
				{ "slug": "lilac", "name": "Lilac", "color": "#F1E6EE" },
				{ "slug": "lilac-deep", "name": "Lilac Deep", "color": "#E5D3E0" },
				{ "slug": "line", "name": "Line", "color": "#EADFE6" },
				{ "slug": "body", "name": "Body", "color": "#3D2A47" },
				{ "slug": "muted", "name": "Muted", "color": "#5B4466" },
				{ "slug": "mist", "name": "Mist", "color": "#F5E9F1" },
				{ "slug": "success", "name": "Success", "color": "#24614A" },
				{ "slug": "success-soft", "name": "Success Soft", "color": "#E7F1EC" },
				{ "slug": "warning", "name": "Warning", "color": "#8A4B12" },
				{ "slug": "warning-soft", "name": "Warning Soft", "color": "#FDEBDD" },
				{ "slug": "danger", "name": "Danger", "color": "#A63E26" },
				{ "slug": "danger-soft", "name": "Danger Soft", "color": "#FDE4DC" },
				{ "slug": "neutral-soft", "name": "Neutral Soft", "color": "#EEE9EC" }
			],
			"gradients": [
				{
					"slug": "overlay-plum",
					"name": "Overlay Plum",
					"gradient": "linear-gradient(90deg, rgba(74, 29, 94, 0.94) 0%, rgba(74, 29, 94, 0.72) 45%, rgba(74, 29, 94, 0.15) 100%)"
				},
				{
					"slug": "overlay-saffron",
					"name": "Overlay Saffron",
					"gradient": "linear-gradient(90deg, rgba(244, 162, 97, 0.94) 0%, rgba(244, 162, 97, 0.72) 45%, rgba(244, 162, 97, 0.15) 100%)"
				},
				{
					"slug": "overlay-lilac",
					"name": "Overlay Lilac",
					"gradient": "linear-gradient(90deg, rgba(241, 230, 238, 0.94) 0%, rgba(241, 230, 238, 0.72) 45%, rgba(241, 230, 238, 0.15) 100%)"
				},
				{
					"slug": "overlay-ink",
					"name": "Overlay Ink",
					"gradient": "linear-gradient(90deg, rgba(42, 21, 51, 0.94) 0%, rgba(42, 21, 51, 0.72) 45%, rgba(42, 21, 51, 0.15) 100%)"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": {
				"minViewportWidth": "390px",
				"maxViewportWidth": "1440px",
				"minFontSize": "12px"
			},
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Schibsted Grotesk",
					"fontFamily": "\"Schibsted Grotesk\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Schibsted Grotesk",
							"fontStyle": "normal",
							"fontWeight": "400 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/schibsted-grotesk/schibsted-grotesk-latin-wght-normal.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Schibsted Grotesk",
							"fontStyle": "normal",
							"fontWeight": "400 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/schibsted-grotesk/schibsted-grotesk-latin-ext-wght-normal.woff2" ],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				},
				{
					"slug": "text",
					"name": "Onest",
					"fontFamily": "Onest, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Onest",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/onest/onest-latin-wght-normal.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Onest",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/onest/onest-latin-ext-wght-normal.woff2" ],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Onest",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/onest/onest-vietnamese-wght-normal.woff2" ],
							"unicodeRange": "U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB"
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "caption", "name": "Caption", "size": "0.875rem", "fluid": { "min": "0.75rem", "max": "0.875rem" } },
				{ "slug": "eyebrow", "name": "Eyebrow", "size": "0.9375rem", "fluid": { "min": "0.75rem", "max": "0.9375rem" } },
				{ "slug": "body-s", "name": "Body Small", "size": "1rem", "fluid": { "min": "0.875rem", "max": "1rem" } },
				{ "slug": "body", "name": "Body", "size": "1.0625rem", "fluid": { "min": "0.9375rem", "max": "1.0625rem" } },
				{ "slug": "body-l", "name": "Body Large", "size": "1.125rem", "fluid": { "min": "0.9375rem", "max": "1.125rem" } },
				{ "slug": "lead", "name": "Lead", "size": "1.375rem", "fluid": { "min": "1.0625rem", "max": "1.375rem" } },
				{ "slug": "name", "name": "Name", "size": "1.5rem", "fluid": { "min": "1.1875rem", "max": "1.5rem" } },
				{ "slug": "card-title", "name": "Card Title", "size": "1.75rem", "fluid": { "min": "1.3125rem", "max": "1.75rem" } },
				{ "slug": "heading-3", "name": "Heading 3", "size": "2rem", "fluid": { "min": "1.375rem", "max": "2rem" } },
				{ "slug": "footer-display", "name": "Footer Display", "size": "2.375rem", "fluid": { "min": "1.75rem", "max": "2.375rem" } },
				{ "slug": "stat", "name": "Stat", "size": "3.125rem", "fluid": { "min": "2.25rem", "max": "3.125rem" } },
				{ "slug": "heading-2", "name": "Heading 2", "size": "3.375rem", "fluid": { "min": "1.75rem", "max": "3.375rem" } },
				{ "slug": "heading-1", "name": "Heading 1", "size": "3.875rem", "fluid": { "min": "1.875rem", "max": "3.875rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "4", "name": "4", "size": "4px" },
				{ "slug": "8", "name": "8", "size": "8px" },
				{ "slug": "12", "name": "12", "size": "12px" },
				{ "slug": "16", "name": "16", "size": "16px" },
				{ "slug": "20", "name": "20", "size": "20px" },
				{ "slug": "24", "name": "24", "size": "24px" },
				{ "slug": "28", "name": "28", "size": "28px" },
				{ "slug": "32", "name": "32", "size": "32px" },
				{ "slug": "40", "name": "40", "size": "40px" },
				{ "slug": "44", "name": "44", "size": "44px" },
				{ "slug": "48", "name": "48", "size": "48px" },
				{ "slug": "56", "name": "56", "size": "56px" },
				{ "slug": "88", "name": "88", "size": "88px" },
				{ "slug": "gutter", "name": "Gutter (56 / 24 / 16)", "size": "var(--tekseries--gutter, 56px)" },
				{ "slug": "section-y", "name": "Section Y (48 → 32)", "size": "clamp(2rem, 1.6286rem + 1.5238vw, 3rem)" },
				{ "slug": "card-gap", "name": "Card Gap (20 → 16)", "size": "clamp(1rem, 0.9071rem + 0.381vw, 1.25rem)" },
				{ "slug": "card-pad", "name": "Card Padding (44 → 24)", "size": "clamp(1.5rem, 1.0357rem + 1.9048vw, 2.75rem)" },
				{ "slug": "hero-y", "name": "Hero Y (88 → 36)", "size": "clamp(2.25rem, 1.0429rem + 4.9524vw, 5.5rem)" },
				{ "slug": "hero-x", "name": "Hero X (56 → 20)", "size": "clamp(1.25rem, 0.4143rem + 3.4286vw, 3.5rem)" }
			]
		},
		"border": {
			"radiusSizes": [
				{ "slug": "sm", "name": "Small (14)", "size": "14px" },
				{ "slug": "md", "name": "Medium (20 → 16)", "size": "clamp(1rem, 0.9071rem + 0.381vw, 1.25rem)" },
				{ "slug": "lg", "name": "Large (28 → 22)", "size": "clamp(1.375rem, 1.2357rem + 0.5714vw, 1.75rem)" },
				{ "slug": "xl", "name": "Extra Large (32 → 24)", "size": "clamp(1.5rem, 1.3143rem + 0.7619vw, 2rem)" },
				{ "slug": "footer", "name": "Footer (36 → 24)", "size": "clamp(1.5rem, 1.2214rem + 1.1429vw, 2.25rem)" },
				{ "slug": "pill", "name": "Pill", "size": "999px" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": []
		},
		"custom": {
			"touch-target": "44px",
			"alpha": {
				"white-10": "rgba(255, 255, 255, 0.1)",
				"white-12": "rgba(255, 255, 255, 0.12)",
				"white-50": "rgba(255, 255, 255, 0.5)",
				"white-70": "rgba(255, 255, 255, 0.7)"
			},
			"tone": {
				"plum": {
					"bg": "var(--wp--preset--color--plum)",
					"text": "var(--wp--preset--color--white)",
					"accent": "var(--wp--preset--color--saffron)",
					"badge-bg": "var(--wp--preset--color--saffron)",
					"badge-text": "var(--wp--preset--color--ink)",
					"deco": "rgba(255, 255, 255, 0.08)"
				},
				"saffron": {
					"bg": "var(--wp--preset--color--saffron)",
					"text": "var(--wp--preset--color--ink)",
					"accent": "var(--wp--preset--color--plum)",
					"badge-bg": "var(--wp--preset--color--ink)",
					"badge-text": "var(--wp--preset--color--white)",
					"deco": "rgba(74, 29, 94, 0.12)"
				},
				"lilac": {
					"bg": "var(--wp--preset--color--lilac)",
					"text": "var(--wp--preset--color--plum)",
					"accent": "var(--wp--preset--color--ink)",
					"badge-bg": "var(--wp--preset--color--plum)",
					"badge-text": "var(--wp--preset--color--white)",
					"deco": "rgba(74, 29, 94, 0.08)"
				},
				"ink": {
					"bg": "var(--wp--preset--color--ink)",
					"text": "var(--wp--preset--color--white)",
					"accent": "var(--wp--preset--color--saffron)",
					"badge-bg": "var(--wp--preset--color--lilac)",
					"badge-text": "var(--wp--preset--color--plum)",
					"deco": "rgba(255, 255, 255, 0.07)"
				}
			},
			"focus": {
				"width": "2px",
				"offset": "2px"
			},
			"motion": {
				"duration": "150ms"
			},
			"letter-spacing": {
				"display": "-0.03em",
				"title": "-0.02em",
				"eyebrow": "0.12em",
				"caption": "0.1em"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|blush",
			"text": "var:preset|color|ink"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|text",
			"fontSize": "var:preset|font-size|body",
			"fontWeight": "400",
			"lineHeight": "1.7"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|16",
			"padding": {
				"top": "0",
				"right": "var:preset|spacing|gutter",
				"bottom": "0",
				"left": "var:preset|spacing|gutter"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|plum" },
				"typography": { "fontWeight": "700", "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var:preset|color|coral-text" }
				},
				":focus-visible": {
					"outline": { "color": "var:preset|color|plum", "offset": "2px", "style": "solid", "width": "2px" }
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|plum",
					"text": "var:preset|color|white"
				},
				"border": {
					"radius": "var:preset|border-radius|pill",
					"style": "none",
					"width": "0"
				},
				"spacing": {
					"padding": {
						"top": "clamp(0.75rem, 0.7036rem + 0.1905vw, 0.875rem)",
						"right": "clamp(1.25rem, 1.1107rem + 0.5714vw, 1.625rem)",
						"bottom": "clamp(0.75rem, 0.7036rem + 0.1905vw, 0.875rem)",
						"left": "clamp(1.25rem, 1.1107rem + 0.5714vw, 1.625rem)"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|text",
					"fontSize": "var:preset|font-size|body",
					"fontWeight": "700",
					"lineHeight": "1.25"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|saffron",
						"text": "var:preset|color|ink"
					}
				},
				":focus-visible": {
					"outline": { "color": "var:preset|color|plum", "offset": "2px", "style": "solid", "width": "2px" }
				}
			},
			"heading": {
				"color": { "text": "var:preset|color|plum" },
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "800",
					"letterSpacing": "-0.03em",
					"lineHeight": "1.1"
				}
			},
			"h1": {
				"typography": { "fontSize": "var:preset|font-size|heading-1", "lineHeight": "1.02" }
			},
			"h2": {
				"typography": { "fontSize": "var:preset|font-size|heading-2", "lineHeight": "1.1" }
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|heading-3",
					"fontWeight": "700",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.1"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|name",
					"fontWeight": "700",
					"letterSpacing": "0",
					"lineHeight": "1.25"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|body-l",
					"fontWeight": "700",
					"letterSpacing": "0",
					"lineHeight": "1.4"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var:preset|font-family|text",
					"fontSize": "var:preset|font-size|eyebrow",
					"fontWeight": "700",
					"letterSpacing": "0.12em",
					"lineHeight": "1.25",
					"textTransform": "uppercase"
				}
			},
			"caption": {
				"color": { "text": "var:preset|color|muted" },
				"typography": {
					"fontSize": "var:preset|font-size|caption",
					"fontWeight": "600",
					"lineHeight": "1.4"
				}
			},
			"cite": {
				"color": { "text": "var:preset|color|coral-text" },
				"typography": {
					"fontSize": "var:preset|font-size|caption",
					"fontStyle": "normal",
					"fontWeight": "700",
					"lineHeight": "1.3"
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"color": { "text": "var:preset|color|plum" },
				"typography": {
					"fontSize": "1rem",
					"fontWeight": "600",
					"lineHeight": "1.25"
				},
				"spacing": { "blockGap": "var:preset|spacing|4" },
				"elements": {
					"link": {
						"color": { "text": "inherit" },
						"typography": { "fontWeight": "600", "textDecoration": "none" },
						":hover": {
							"color": { "text": "var:preset|color|plum" }
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": { "text": "inherit" },
						"typography": { "fontWeight": "inherit", "textDecoration": "none" }
					}
				}
			},
			"core/site-title": {
				"elements": {
					"link": {
						"color": { "text": "inherit" },
						"typography": { "fontWeight": "inherit", "textDecoration": "none" }
					}
				}
			}
		}
	}
}
