{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tekseries/job-listings",
	"version": "0.1.0",
	"title": "Job Listings",
	"category": "widgets",
	"icon": "list-view",
	"description": "WP Job Manager's open jobs with search filters and page links. Built on the server, so searching and paging work without JavaScript.",
	"keywords": [ "jobs", "job series", "listings", "search" ],
	"textdomain": "tekseries-blocks",
	"attributes": {
		"perPage": {
			"type": "integer",
			"default": 25
		}
	},
	"supports": {
		"html": false,
		"multiple": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true
		},
		"interactivity": true
	},
	"editorScript": "file:./index.js",
	"viewScriptModule": "file:./view.js",
	"style": [ "file:./style-index.css", "tekseries-blocks-job" ],
	"render": "file:./render.php"
}
