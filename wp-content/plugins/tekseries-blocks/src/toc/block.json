{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tekseries/toc",
	"version": "0.1.0",
	"title": "Table of Contents",
	"category": "theme",
	"icon": "list-view",
	"description": "Lists the post's headings that have an HTML anchor, as links, and marks the section being read. Built on the server, so the links work without JavaScript.",
	"keywords": [ "toc", "contents", "on this page", "headings" ],
	"textdomain": "tekseries-blocks",
	"usesContext": [ "postId" ],
	"attributes": {},
	"supports": {
		"html": false,
		"spacing": {
			"margin": true
		},
		"interactivity": true
	},
	"editorScript": "file:./index.js",
	"viewScriptModule": "file:./view.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
