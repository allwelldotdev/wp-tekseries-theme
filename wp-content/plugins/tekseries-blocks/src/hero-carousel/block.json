{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tekseries/hero-carousel",
	"version": "0.1.0",
	"title": "Hero Carousel",
	"category": "design",
	"icon": "slides",
	"description": "Cover blocks shown one at a time as slides. Visitors swipe or use the dots to move between them, and the slides can change by themselves; it works without JavaScript.",
	"keywords": [ "slider", "slides", "carousel", "hero" ],
	"textdomain": "tekseries-blocks",
	"allowedBlocks": [ "core/cover" ],
	"attributes": {
		"ariaLabel": {
			"type": "string"
		},
		"autoplay": {
			"type": "boolean",
			"default": false
		},
		"interval": {
			"type": "integer",
			"default": 7
		},
		"pauseOnHover": {
			"type": "boolean",
			"default": true
		},
		"dotSpacing": {
			"type": "string",
			"enum": [ "touch", "close" ],
			"default": "touch"
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"ariaLabel": true,
		"spacing": {
			"margin": true
		},
		"__experimentalBorder": {
			"radius": true,
			"__experimentalDefaultControls": {
				"radius": true
			}
		},
		"interactivity": true
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"viewScriptModule": "file:./view.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
