{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tekseries/post-tone",
	"version": "0.1.0",
	"title": "Post Tone",
	"category": "theme",
	"icon": "art",
	"description": "Colours its contents with the post's tone and shows its topic icon. Use it for listing card media and post banners.",
	"keywords": [ "tone", "card", "banner" ],
	"textdomain": "tekseries-blocks",
	"usesContext": [ "postId", "postType" ],
	"attributes": {
		"variant": {
			"type": "string",
			"enum": [ "card", "banner" ],
			"default": "card"
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"layout": {
			"default": {
				"type": "flex",
				"orientation": "vertical",
				"justifyContent": "stretch"
			},
			"allowSwitching": false,
			"allowInheriting": false
		},
		"spacing": {
			"padding": true,
			"margin": [ "top", "bottom" ],
			"blockGap": true
		},
		"dimensions": {
			"minHeight": true,
			"aspectRatio": true
		},
		"__experimentalBorder": {
			"radius": true
		},
		"interactivity": {
			"clientNavigation": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
