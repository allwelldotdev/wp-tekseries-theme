{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": "WordPress/WordPress#7.1.3",
	"phpVersion": "8.2",
	"testsEnvironment": false,
	"port": 8890,
	"themes": [ "./wp-content/themes/tekseries" ],
	"plugins": [
		"https://downloads.wordpress.org/plugin/advanced-custom-fields.6.8.10.zip",
		"./wp-content/plugins/tekseries-blocks"
	],
	"config": {
		"WP_DEBUG_LOG": true,
		"WP_DEVELOPMENT_MODE": "theme"
	},
	"lifecycleScripts": {
		"afterStart": "wp-env run cli wp theme activate tekseries",
		"afterReset": "wp-env run cli wp theme activate tekseries"
	}
}
